generator client {
  provider = "prisma-client-js"  // ✅ v6 uses this provider
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  sections  Section[]
  footer    Footer?   // Keep this relation
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Section {
  id        String   @id @default(uuid())
  pageId    String
  type      String
  order     Int
  content   Json

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Footer {
  id          String   @id @default(uuid())
  pageId      String   @unique
  phone       String
  email       String
  address     String
  socialMedia Json
  copyright   String

  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// Keep your other models (User, Service, etc.)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ContactMessage[]
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  message   String
  serviceId String

  service   Service  @relation(fields: [serviceId], references: [id])
  
  createdAt DateTime @default(now())
}

model BlogPost {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  category     String
  coverImage   String?
  excerpt      String
  content      String
  status       BlogStatus @default(DRAFT)
  author       String
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("blog_posts")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}