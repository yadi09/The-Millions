# Copy to .env and fill in real values. The server validates these at boot
# via src/config/env.ts and exits 1 with an itemized error list on misconfig.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/the_millions"

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET="generate_a_long_random_string_at_least_32_chars_long"

# Comma-separated list of allowed origins (no trailing slash). REQUIRED.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional rate-limit overrides (defaults shown)
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_CONTACT_MAX=10
# RATE_LIMIT_CONTACT_WINDOW_MS=3600000

# Optional body size cap for express.json() (default: 1mb)
# BODY_LIMIT=1mb
