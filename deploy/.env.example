# Production compose env — copy to deploy/.env and fill in.
# deploy/init-secrets.sh will generate the random values for you.
#
# DO NOT COMMIT deploy/.env. The .gitignore in this directory excludes it.

# --- Hostname / TLS ---
# For the EC2 dry-run: leave SERVER_NAME as `_` (matches any host); the cert
# will be self-signed. For Fast Host with a real domain: set to themillions.co.uk
SERVER_NAME=_

# TLS certs live at deploy/certs/{fullchain,privkey}.pem — issue-cert.sh
# writes them there, and docker-compose.prod.yml mounts the same directory.
# Do NOT add a CERTS_DIR= line here: it would override the path computed by
# issue-cert.sh and send certs to the wrong place.

# --- Postgres ---
POSTGRES_USER=themillions
POSTGRES_DB=themillions
# Generated by init-secrets.sh; min 24 chars random.
POSTGRES_PASSWORD=REPLACE_ME

# --- App secrets ---
# Generated by init-secrets.sh; 64-char hex from openssl rand.
JWT_SECRET=REPLACE_ME

# Long-lived service token for external AI agent / integration platforms (e.g.
# WhatsApp bot) hitting POST /api/agent/leads. Authenticate via X-API-Key
# header. Must be at least 32 characters. Generated by init-secrets.sh.
# Rotate by editing this value and restarting the backend container.
AGENT_API_KEY=REPLACE_ME

# Comma-separated. For dry-run with the public IP: http://EC2_IP,https://EC2_IP
# For real prod: https://themillions.co.uk,https://www.themillions.co.uk
CORS_ORIGINS=https://example.com

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Initial seed admin (only used the very first time, by `make seed`) ---
ADMIN_EMAIL=admin@themillions.co.uk
ADMIN_PASSWORD=REPLACE_ME
